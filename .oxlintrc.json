{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "oxc"],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn"
  },
  "ignorePatterns": ["dist/**", "db/**", "*.min.js", "drizzle/**"]
}
